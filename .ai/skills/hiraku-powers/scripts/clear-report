#!/usr/bin/env bash
# Remove the implement report before dispatching a (re-)run, so a stale DONE
# from an earlier attempt can never be mistaken for the new result.
#
# Usage: clear-report RECORD_ID
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/_lib.sh"
[ $# -eq 1 ] || { echo "usage: clear-report RECORD_ID" >&2; exit 2; }
dir=$(bash "$here/workspace" "$1")
rm -f "$dir/report.md"
ledger_append "$dir" "note: cleared report.md before dispatch"
