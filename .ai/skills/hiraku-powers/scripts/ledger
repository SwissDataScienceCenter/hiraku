#!/usr/bin/env bash
# Append to the record's ledger, the recovery map after context loss. Stage
# detection reads only reserved marker lines, so free-form text is stored as
# "note: ..." and can never collide with a marker. Entries are one line.
#
# Usage: ledger RECORD_ID "note text"
#        ledger RECORD_ID --marker base            once; HEAD at start (stage implement)
#        ledger RECORD_ID --marker implement-started   main agent, at dispatch
#        ledger RECORD_ID --marker implement-done      needs a bound commit and report.md DONE
#        ledger RECORD_ID --marker implement-stop "reason"   (also from a subagent that
#                                                      returned without a marker)
#        ledger RECORD_ID --marker review-started      main agent, at review dispatch
#        ledger RECORD_ID --marker review-stop "reason"   close a reviewer that left no drafts
#        ledger RECORD_ID --marker review-drafted      needs findings, result, decision
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/_lib.sh"
usage() { sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -ge 2 ] || usage
id=$1
dir=$(bash "$here/workspace" "$id")
if [ "$2" != "--marker" ]; then
  [ $# -eq 2 ] || usage
  ledger_append "$dir" "note: $2"
  exit 0
fi
[ $# -ge 3 ] || usage
case "$3" in
  base)
    require_stage "$id" implement
    existing=$(grep -E "${LEDGER_LINE}base " "$dir/ledger.md" | head -n1 | cut -d' ' -f3 || true)
    if [ -n "$existing" ]; then echo "base already recorded: $existing"; exit 0; fi
    sha=$(git rev-parse HEAD)
    ledger_append "$dir" "base $sha"
    echo "base $sha" ;;
  implement-started)
    require_stage "$id" implement
    ledger_append "$dir" "implement started" ;;
  implement-done)
    require_stage "$id" implement
    [ -n "$(hk record show --raw --json -- "$id" | jq -r '.values.commit // empty')" ] \
      || { echo "no commit is bound to $id; bind it first" >&2; exit 3; }
    grep -qx 'Status: DONE' "$dir/report.md" 2>/dev/null \
      || { echo "report.md is missing or not 'Status: DONE'" >&2; exit 3; }
    ledger_append "$dir" "implement done" ;;
  implement-stop)
    # Allowed in stage plan too so an implementer can always write its stop after
    # the plan drifted; state ignores it unless the stage is still implement.
    require_stage "$id" implement plan
    [ -n "${4:-}" ] || { echo "implement-stop needs a reason" >&2; exit 2; }
    ledger_append "$dir" "implement stop: $4" ;;
  review-started)
    require_stage "$id" review
    ledger_append "$dir" "review started" ;;
  review-stop)
    require_stage "$id" review
    [ -n "${4:-}" ] || { echo "review-stop needs a reason" >&2; exit 2; }
    ledger_append "$dir" "review stop: $4" ;;
  review-drafted)
    require_stage "$id" review
    for f in findings.md result.md decision.md; do
      grep -q '[^[:space:]]' "$dir/$f" 2>/dev/null \
        || { echo "$f is missing or blank in $dir" >&2; exit 3; }
    done
    ledger_append "$dir" "review drafted" ;;
  *) usage ;;
esac
