#!/usr/bin/env bash
# Revoke an approval and send the record back a stage. Use whenever the plan or
# proposal changes after approval, or the router moves you back a stage. A
# finished record cannot be reopened: a fix is a new related record.
#
# Usage: reopen RECORD_ID plan | proposal
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/_lib.sh"
[ $# -eq 2 ] && { [ "$2" = plan ] || [ "$2" = proposal ]; } \
  || { echo "usage: reopen RECORD_ID plan|proposal" >&2; exit 2; }
dir=$(bash "$here/workspace" "$1")
stage=$(current_stage "$1")
[ "$stage" != done ] \
  || { echo "record $1 is finished; create a new related record instead" >&2; exit 7; }
if bash "$here/state" "$1" | grep -qx 'dispatched: yes'; then
  echo "a subagent is still dispatched for $1; wait for it, or close it with: ledger $1 --marker implement-stop \"<reason>\"" >&2
  exit 7
fi
if [ "$2" = plan ]; then
  require_stage "$1" implement review present
else
  require_stage "$1" plan implement review present
fi
ledger_append "$dir" "$2 reopened"
echo "reopened $1 $2"
