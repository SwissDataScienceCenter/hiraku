#!/usr/bin/env bash
# Assemble head, summary, plan and rest into the record body and apply it with
# `hiraku record update --markdown-file`. Before writing, the assembled body is
# split again and must equal the parts (this catches unclosed fences and odd
# headings that would fold one part into another). Refuses when the workspace
# was never seeded, a part is missing or malformed, a part that had content is
# now empty (unless --drop PART), or the record body changed since the last
# pull (then: `pull ID --to DIR`, merge by hand, `push ID --force`).
#
# Usage: push RECORD_ID [--force] [--drop PART]...
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/_lib.sh"
usage() { echo "usage: push RECORD_ID [--force] [--drop head|plan|rest]..." >&2; exit 2; }
[ $# -ge 1 ] || usage
id=$1; shift
force=0
drops=" "
while [ $# -gt 0 ]; do
  case "$1" in
    --force) force=1 ;;
    --drop)
      shift; [ $# -gt 0 ] || usage
      case "$1" in head|plan|rest) drops="$drops$1 " ;; *) usage ;; esac ;;
    *) usage ;;
  esac
  shift
done

dir=$(workspace_dir "$id")
[ -f "$dir/.pulled-sha" ] \
  || { echo "workspace not seeded; run workspace $id first" >&2; exit 4; }
lock "$dir"

for part in $PARTS; do
  [ -f "$dir/$part.md" ] || { echo "$part.md is missing from the workspace" >&2; exit 3; }
  if [ ! -s "$dir/$part.md" ] && [ -s "$dir/.synced/$part.md" ]; then
    case "$drops" in
      *" $part "*) ;;
      *)
        if [ "$part" = summary ]; then
          echo "summary.md is empty; the record body must start with '## Summary' (it cannot be dropped)" >&2
        else
          echo "$part.md is empty but the record had content; pass --drop $part to remove it" >&2
        fi
        exit 3 ;;
    esac
  fi
done

# Each part holds exactly its own top-level section, so nothing is folded away.
headings() { awk -v mode=headings -f "$SECTIONS" "$dir/$1.md"; }
expect() { # part, required heading ("" = none allowed)
  local found
  found=$(headings "$1")
  if [ -z "$2" ]; then
    [ -z "$found" ] || { echo "$1.md must not contain top-level '## ' headings (use ###): $found" >&2; exit 3; }
  elif [ -s "$dir/$1.md" ] || [ "$1" = summary ]; then
    [ "$found" = "$2" ] || { echo "$1.md must have exactly one '## ' heading, '$2' (use ### inside it)" >&2; exit 3; }
    [ "$(head -n1 "$dir/$1.md" | sed 's/[[:space:]]*$//')" = "$2" ] \
      || { echo "$1.md must start with '$2'" >&2; exit 3; }
  fi
}
expect head ""
expect summary "## Summary"
expect plan "## Plan"
if headings rest | grep -qxE '## (Summary|Plan)'; then
  echo "rest.md must not contain '## Summary' or '## Plan'" >&2; exit 3
fi

if [ "$force" = 0 ] && [ "$(body_of "$id" | sha_of)" != "$(cat "$dir/.pulled-sha")" ]; then
  # A push that died after writing the record leaves the body equal to the
  # workspace but not to the snapshot: recognise that and carry on.
  cur=$(mktemp -d)
  split_body "$id" "$cur"
  same=1
  for part in $PARTS; do
    trim < "$dir/$part.md" | cmp -s - "$cur/$part.md" || same=0
  done
  rm -rf "$cur"
  if [ "$same" = 1 ]; then
    echo "note: the record body differs from the last pull but matches the workspace parts (a crashed push, or sections reordered or reformatted elsewhere); continuing" >&2
  fi
  if [ "$same" = 0 ]; then
    echo "record body changed since pull. Merge: pull $id --to <dir>, diff against" >&2
    echo "the workspace parts, merge by hand, then push $id --force" >&2
    exit 4
  fi
fi
[ ! -s "$dir/head.md" ] || echo "warning: head.md is not empty, so the body will not start with '## Summary'" >&2

out=$(mktemp)
check=$(mktemp -d)
trap 'rm -rf "$out" "$check" "$LOCK_DIR/.lock"' EXIT
first=1
for part in $PARTS; do
  [ -s "$dir/$part.md" ] || continue
  [ "$first" = 1 ] || printf '\n'
  first=0
  trim < "$dir/$part.md"
done > "$out"

split_text "$check" < "$out"
for part in $PARTS; do
  trim < "$dir/$part.md" | cmp -s - "$check/$part.md" \
    || { echo "assembled body would not round-trip ($part.md changes when split again): unclosed code fence or odd heading?" >&2; exit 3; }
done

hk record update --markdown-file "$out" -- "$id"
HP_LOCKED=1 bash "$here/pull" "$id" --discard >/dev/null
echo "pushed $id"
