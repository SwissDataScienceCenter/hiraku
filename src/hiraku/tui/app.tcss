Screen {
    background: $surface;
}

#workspace {
    height: 1fr;
    padding: 0 1 1 1;
}

#record-sidebar {
    width: 38%;
    min-width: 28;
    max-width: 60;
    height: 1fr;
    margin-right: 1;
    padding: 0 1 0 0;
    border-right: tall $primary 35%;
    background: $surface;
}

#sidebar-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    content-align: left middle;
}

#record-tree {
    height: 1fr;
    min-height: 0;
    padding: 0 1;
    background: transparent;
    border: none;
}

#record-tree:focus {
    background-tint: $accent 3%;
}

#detail-panel {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

#record-heading {
    height: auto;
    min-height: 3;
    max-height: 6;
    margin-bottom: 1;
    padding: 0 1;
    background: $surface;
    background-tint: $primary 8%;
    border-left: tall $primary 55%;
}

#record-summary {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#record-state {
    width: auto;
    height: 1;
    margin: 1 1 0 1;
    padding: 0 1;
    color: $text-muted;
}

#record-tabs {
    height: 1fr;
    min-height: 0;
    border: none;
}

#overview-scroll,
#fields-scroll {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    border: none;
    padding: 0 1;
}

#overview-scroll:focus,
#fields-scroll:focus {
    background-tint: $accent 3%;
}

#record-overview,
#record-fields {
    height: auto;
    padding: 1 2;
}

#markdown-panel {
    height: 1fr;
    min-height: 0;
    padding: 0 1 1 1;
}

#markdown-controls {
    height: 3;
    align: left middle;
    padding: 0 1;
}

#markdown-controls Button {
    margin-right: 1;
}

#edit-status {
    width: 1fr;
    padding: 1;
    color: $text-muted;
}

#markdown-preview {
    height: 1fr;
    min-height: 0;
    border: none;
    padding: 0 1;
}

#markdown-preview > Markdown {
    height: auto;
    padding: 1 2;
}

#markdown-editor {
    display: none;
    height: 1fr;
    min-height: 0;
    border: tall $secondary 50%;
    background: $surface;
}

#markdown-editor:focus {
    background-tint: $accent 3%;
}
